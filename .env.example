# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_USER=XXXXXXXXX
POSTGRES_PASSWORD=XXXXXXXXX
POSTGRES_DB=XXXXXXXXXX
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
QUEUE_PREFIX=merchant
DB_LOGGING=false

# Field-level encryption keys: comma-separated keyId:base64(32 bytes), active key first.
# Generate one with:  echo "v1:$(openssl rand -base64 32)"
FIELD_ENCRYPTION_KEYS=

# Integration tests run against this database (created by infra/postgres/init).
POSTGRES_TEST_DB=merchant_test

# pnpm db:seed only. Choose a local password of 12+ chars.
SEED_USER_PASSWORD=

# Access token signing secret. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Simulated KYB provider (latency in ms, transient failure probability 0..1)
KYB_LATENCY_MS=300
KYB_FAILURE_RATE=0.1

# HMAC secrets for KYB webhooks, comma-separated to rotate (new,old). Generate: openssl rand -hex 32
KYB_WEBHOOK_SECRETS=

# KYB mode: sync (worker waits for the result) or callback (signed webhook delivers it later)
KYB_MODE=sync
KYB_CALLBACK_TIMEOUT_MS=1800000
KYB_WEBHOOK_URL=http://localhost:3000/webhooks/kyb
