{
  "name": "merchant-application",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --enable-source-maps --watch-path=dist dist/main.js\" \"node --env-file-if-exists=.env --enable-source-maps --watch-path=dist dist/worker.js\"",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start:worker": "node --env-file-if-exists=.env --enable-source-maps dist/worker.js",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "pnpm test --selectProjects unit",
    "test:integration": "pnpm test --selectProjects integration",
    "test:cov": "pnpm test --coverage",
    "typeorm": "node --env-file-if-exists=.env node_modules/typeorm/cli.js",
    "migration:create": "node node_modules/typeorm/cli.js migration:create",
    "migration:generate": "pnpm build && pnpm typeorm migration:generate --pretty -d dist/core/database/data-source.js",
    "migration:run": "pnpm build && pnpm typeorm migration:run -d dist/core/database/data-source.js",
    "migration:revert": "pnpm build && pnpm typeorm migration:revert -d dist/core/database/data-source.js",
    "migration:show": "pnpm build && pnpm typeorm migration:show -d dist/core/database/data-source.js",
    "schema:log": "pnpm build && pnpm typeorm schema:log -d dist/core/database/data-source.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:seed": "pnpm build && node --env-file-if-exists=.env dist/core/database/seed.js"
  },
  "dependencies": {
    "@casl/ability": "7.0.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "jest": "30.5.2",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "6.0.3"
  }
}
